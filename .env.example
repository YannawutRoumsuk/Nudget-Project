# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://spendbot:spendbot@localhost:5433/spendbot
PUBLIC_BASE_URL=https://your-stable-https-url.example
OCR_MODE=inline
# ตัวอ่านสลิป: auto = ใช้ Gemini เมื่อมีคีย์ แล้วถอยไป tesseract ถ้าอ่านไม่ได้
# gemini = บังคับใช้ Gemini อย่างเดียว (เร็วสุด), tesseract = อ่านในเครื่องอย่างเดียว
# หมายเหตุความเป็นส่วนตัว: gemini/auto จะอัปโหลดรูปสลิปทั้งใบไปที่ Google
# ซึ่งอาจมีเลขบัญชีหรือเบอร์โทรที่แอปไม่ได้เก็บ ถ้าไม่ต้องการให้ใช้ tesseract
OCR_PROVIDER=auto
# การอ่านสลิปใช้ GEMINI_API_KEY โดยตรง แยกจาก LLM_PROVIDER ของ parser
# จึงตั้ง Claude ไว้อ่านข้อความ แล้วใช้ Gemini อ่านสลิปพร้อมกันได้
OCR_MODEL=gemini-2.5-flash

# --- LINE Messaging API ---------------------------------------------------
# LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Comma-separated list of OWNERS. They have access before any database row
# exists, and they are the only ones who can see the member list or revoke
# someone. Everyone else gets an account by adding the bot as a friend.
# Send ไอดี to the bot to retrieve an id, then set it here and restart.
# A shared DASHBOARD_PASSWORD login only works while exactly one id is listed.
LINE_ALLOWED_USER_ID=

# The bot's public @id, shown with a QR on the login page so someone who found
# the web first can add the bot — the only way to get an account. After changing
# this, regenerate the QR with `bun run line:qr`.
LINE_ADD_FRIEND_ID=

# --- LINE Login / LIFF ----------------------------------------------------
# LINE Developers Console > LINE Login channel > LIFF
LIFF_ID=

# --- Bill reminders (Bangkok time) ---------------------------------------
# timer = local/always-on server, cron = Railway scheduled job
REMINDER_MODE=timer
REMINDER_HOUR=9
REMINDER_DAYS_BEFORE=3

# --- Dashboard login ------------------------------------------------------
# Single-user password gate for the web dashboard.
DASHBOARD_PASSWORD=changeme
# openssl rand -hex 32
SESSION_SECRET=

# --- LLM fallback parser (optional) --------------------------------------
# Leave both blank to run rule-based only.
# Set exactly one. anthropic -> ANTHROPIC_API_KEY, gemini -> GEMINI_API_KEY
# LLM_PROVIDER=none explicitly disables LLM calls even if a key is present.
# บทวิเคราะห์รายเดือนบนเว็บใช้ผู้ให้บริการและรุ่นเดียวกันนี้ ไม่ได้ตั้งแยก
# คิดค่าใช้จ่าย 1 ครั้งต่อ 1 เดือนที่ตัวเลขเปลี่ยน ต่อ 1 คน — เปิดซ้ำใช้ของเดิม
# ส่งไปเฉพาะยอดรวมของเดือน ไม่มีรายการเดี่ยว โน้ต ชื่อร้าน หรือไอดี LINE
# LLM_PROVIDER=none ปิดทั้งตัวช่วยแยกข้อความและบทวิเคราะห์พร้อมกัน
LLM_PROVIDER=
# เว้นว่างไว้เพื่อใช้รุ่นเริ่มต้นของผู้ให้บริการนั้น
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- PostgreSQL backup cron (separate Railway service) -------------------
# Use Railway Bucket reference variables. Never commit real credentials.
ENDPOINT=
BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BACKUP_PREFIX=nudget/postgres
BACKUP_RETENTION_DAYS=30
# Optional: send a fixed failure alert to the owner without database contents.
BACKUP_ALERT_LINE_USER_ID=
