# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://spendbot:spendbot@localhost:5433/spendbot
PUBLIC_BASE_URL=https://your-stable-https-url.example
OCR_MODE=inline

# --- LINE Messaging API ---------------------------------------------------
# LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Required for personal ledger access. Blank only allows identity setup.
# Send ไอดี to retrieve your id, then set it here and restart the dev server.
LINE_ALLOWED_USER_ID=

# --- LINE Login / LIFF ----------------------------------------------------
# LINE Developers Console > LINE Login channel > LIFF
LIFF_ID=

# --- Bill reminders (Bangkok time) ---------------------------------------
# timer = local/always-on server, cron = Railway scheduled job
REMINDER_MODE=timer
REMINDER_HOUR=9
REMINDER_DAYS_BEFORE=3

# --- Dashboard login ------------------------------------------------------
# Single-user password gate for the web dashboard.
DASHBOARD_PASSWORD=changeme
# openssl rand -hex 32
SESSION_SECRET=

# --- LLM fallback parser (optional) --------------------------------------
# Leave both blank to run rule-based only.
# Set exactly one. anthropic -> ANTHROPIC_API_KEY, gemini -> GEMINI_API_KEY
# LLM_PROVIDER=none explicitly disables LLM calls even if a key is present.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
