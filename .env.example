# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://spendbot:spendbot@localhost:5433/spendbot
PUBLIC_BASE_URL=https://your-stable-https-url.example
OCR_MODE=inline
# ตัวอ่านสลิป: auto = ใช้ Gemini เมื่อมีคีย์ แล้วถอยไป tesseract ถ้าอ่านไม่ได้
# gemini = บังคับใช้ Gemini อย่างเดียว (เร็วสุด), tesseract = อ่านในเครื่องอย่างเดียว
# หมายเหตุความเป็นส่วนตัว: gemini/auto อัปโหลดรูปสลิปทั้งใบออกไปนอกเครื่อง
# ในรูปมีชื่อผู้โอน ชื่อผู้รับ ธนาคาร เลขอ้างอิง และอาจมีเลขบัญชีหรือเบอร์โทร
# ที่แอปไม่ได้เก็บลงฐานข้อมูลเลย ถ้าไม่ต้องการให้ส่งออกเลยให้ใช้ tesseract
# ปลายทางขึ้นกับ OCR_API_PROVIDER ด้านล่าง google = ถึง Google เจ้าเดียว
# openrouter = ผ่าน gateway อีกทอดหนึ่งก่อนถึงโมเดล จึงมีผู้เห็นรูปสองราย
# ด้วยเหตุนี้คีย์ OpenRouter เพียงอย่างเดียวจะไม่เปิดการอ่านสลิปให้อัตโนมัติ
# ต้องตั้ง OCR_API_PROVIDER=openrouter เองจึงจะส่งรูปออกไปทางนั้น
OCR_PROVIDER=auto
# การอ่านสลิปมีคีย์และรุ่นของตัวเอง แยกจาก LLM_PROVIDER ของ parser
# จึงตั้ง Claude ไว้อ่านข้อความ แล้วใช้ Gemini อ่านสลิปพร้อมกันได้
# เส้นทางที่ใช้เรียก: google = ยิงตรงด้วย GEMINI_API_KEY,
# openrouter = ผ่าน gateway ด้วย OPENROUTER_API_KEY, none = ปิดการส่งรูปออก
# เว้นว่างไว้ = เปิดเองเฉพาะเมื่อมีคีย์ Google ถ้ามีแต่คีย์ OpenRouter จะยังไม่ส่ง
OCR_API_PROVIDER=
# ชื่อรุ่นมี namespace เมื่อผ่าน gateway เช่น google/gemini-2.5-flash
# แต่เป็นชื่อเปล่าเมื่อยิงตรง เช่น gemini-2.5-flash
OCR_MODEL=gemini-2.5-flash
OCR_DAILY_LIMIT=20
OCR_MAX_OUTPUT_TOKENS=600
OCR_TIMEOUT_MS=12000

# --- LINE Messaging API ---------------------------------------------------
# LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Comma-separated list of OWNERS. They have access before any database row
# exists, and they are the only ones who can see the member list or revoke
# someone. Everyone else gets an account by adding the bot as a friend.
# Send ไอดี to the bot to retrieve an id, then set it here and restart.
# A shared DASHBOARD_PASSWORD login only works while exactly one id is listed.
LINE_ALLOWED_USER_ID=

# The bot's public @id, shown with a QR on the login page so someone who found
# the web first can add the bot — the only way to get an account. After changing
# this, regenerate the QR with `bun run line:qr`.
LINE_ADD_FRIEND_ID=

# --- LINE Login / LIFF ----------------------------------------------------
# LINE Developers Console > LINE Login channel > LIFF
LIFF_ID=

# --- Bill reminders (Bangkok time) ---------------------------------------
# timer = local/always-on server, cron = Railway scheduled job
REMINDER_MODE=timer
REMINDER_HOUR=9
REMINDER_DAYS_BEFORE=3

# --- Dashboard login ------------------------------------------------------
# Single-user password gate for the web dashboard.
DASHBOARD_PASSWORD=changeme
# openssl rand -hex 32
SESSION_SECRET=

# --- LLM fallback parser (optional) --------------------------------------
# Leave the keys blank to run rule-based only.
# anthropic -> ANTHROPIC_API_KEY, gemini -> GEMINI_API_KEY,
# openrouter -> OPENROUTER_API_KEY
# LLM_PROVIDER=none explicitly disables LLM calls even if a key is present.
# บทวิเคราะห์รายเดือนบนเว็บใช้ผู้ให้บริการและรุ่นเดียวกันนี้ ไม่ได้ตั้งแยก
# คิดค่าใช้จ่าย 1 ครั้งต่อ 1 เดือนที่ตัวเลขเปลี่ยน ต่อ 1 คน — เปิดซ้ำใช้ของเดิม
# ส่งไปเฉพาะยอดรวมของเดือน ไม่มีรายการเดี่ยว โน้ต ชื่อร้าน หรือไอดี LINE
# LLM_PROVIDER=none ปิดทั้งตัวช่วยแยกข้อความและบทวิเคราะห์พร้อมกัน
#
# ถ้าใช้ OpenRouter: LLM_PROVIDER=openrouter และ LLM_MODEL ต้องมี namespace
# เช่น google/gemini-2.5-flash-lite ซึ่งถูกที่สุดในตระกูลและอ่านไทยได้
# 3.1-flash-lite แพงกว่าราว 3 เท่าโดยงานนี้ไม่ต้องการความสามารถที่เพิ่มมา
# ตระกูล 3.x มักเปิด thinking เป็นค่าเริ่มต้น และโทเคน thinking คิดเป็นขาออก
# ตรวจค่าจริงได้จากตาราง llm_usage ที่เก็บโทเคนเข้าออกไว้ทุกครั้ง
LLM_PROVIDER=
# เว้นว่างไว้เพื่อใช้รุ่นเริ่มต้นของผู้ให้บริการนั้น
LLM_MODEL=
# parser ใช้ rules ก่อนเสมอ ค่านี้จำกัดเฉพาะ fallback ที่ต้องเสีย token
LLM_PARSER_DAILY_LIMIT=20
LLM_PARSER_MAX_INPUT_CHARS=500
LLM_PARSER_MAX_OUTPUT_TOKENS=150
LLM_TIMEOUT_MS=8000
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- PostgreSQL backup cron (separate Railway service) -------------------
# Use Railway Bucket reference variables. Never commit real credentials.
ENDPOINT=
BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BACKUP_PREFIX=nudget/postgres
BACKUP_RETENTION_DAYS=30
# Optional: send a fixed failure alert to the owner without database contents.
BACKUP_ALERT_LINE_USER_ID=
